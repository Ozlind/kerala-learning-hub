# Free-first provider order. Ollama stays local; remote providers are attempted only when their keys exist.
# Remove providers you do not want. No paid provider is supported or used as fallback.
AI_PROVIDER_ORDER=ollama,gemini,groq,cerebras,openrouter

# Local inference (recommended for privacy; install Ollama and pull the model separately).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Google AI Studio free-tier key (quotas and eligibility can change).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq developer/free tier (subject to provider rate limits).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Cerebras free tier (subject to provider rate limits).
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.1-8b

# OpenRouter Free Models Router only. Keep the model at openrouter/free to avoid paid model selection.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional read-only GitHub API token. Public repository reads work without it.
GITHUB_TOKEN=

PORT=8787
PROVIDER_TIMEOUT_MS=45000
MIN_RUN_INTERVAL_MS=3000
